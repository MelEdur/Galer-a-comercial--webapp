# PostgreSQL
POSTGRES_USER=galeria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=galeria
POSTGRES_PORT=5433

# Backend
ENVIRONMENT=development
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://galeria:change-me@db:5432/galeria
TEST_DATABASE_URL=postgresql+psycopg://galeria:change-me@db:5432/app_test
CORS_ORIGINS=http://localhost:5173

# Autenticación
JWT_SECRET=change-me-use-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Administrador inicial (solo para el script create_admin)
ADMIN_EMAIL=admin@galeria.local
ADMIN_PASSWORD=change-me-admin
ADMIN_FULL_NAME=Administrador

# Asistente virtual (Groq)
GROQ_API_KEY=change-me-groq-key
GROQ_MODEL=
GROQ_MODEL_PREFERENCES=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
ASSISTANT_TOP_K=5
ASSISTANT_MAX_MESSAGE_CHARS=1000
ASSISTANT_MAX_HISTORY_MESSAGES=10
ASSISTANT_RATE_LIMIT=20
ASSISTANT_RATE_WINDOW_SECONDS=300
ASSISTANT_TIMEOUT_SECONDS=20
CHROMA_PATH=/data/chroma
HF_HOME=/data/hf

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api
